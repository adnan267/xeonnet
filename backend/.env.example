# ---- required on the live server ----
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SITE_URL=https://xeonnet.site
AUTO_MIGRATE=1
ADMIN_EMAIL=info@xeonnet.site
ADMIN_PASSWORD=choose-a-strong-password
CRON_SECRET=another-long-random-string

# ---- email (Resend recommended) ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Xeon Net <info@xeonnet.site>

# ---- SMS (choose one; leave console until you have an account) ----
SMS_PROVIDER=console
# Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+44...
# Any HTTP gateway (most Pakistani SMS companies):
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://provider.example/api/send?key=YOURKEY&to={to}&msg={message}
# SMS_HTTP_METHOD=GET

# local development only
# DEBUG=1
